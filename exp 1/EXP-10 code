data = [1,2,3,10,11,12]

m1 = 2
m2 = 11

for i in range(5):

    c1 = []
    c2 = []

    for x in data:
        if abs(x-m1) < abs(x-m2):
            c1.append(x)
        else:
            c2.append(x)

    m1 = sum(c1) / len(c1)
    m2 = sum(c2) / len(c2)

print("Cluster 1:", c1)
print("Cluster 2:", c2)
print("Mean 1:", m1)
print("Mean 2:", m2)
