# Candidate Elimination Algorithm

data = [
    ['Sunny', 'Warm', 'Normal', 'Strong', 'Warm', 'Same', 'Yes'],
    ['Sunny', 'Warm', 'High', 'Strong', 'Warm', 'Same', 'Yes'],
    ['Rainy', 'Cold', 'High', 'Strong', 'Warm', 'Change', 'No'],
    ['Sunny', 'Warm', 'High', 'Strong', 'Cool', 'Change', 'Yes']
]

# Number of attributes
n = len(data[0]) - 1

# Specific boundary
S = ['0'] * n

# General boundary
G = [['?'] * n]

# Process each training example
for row in data:

    attributes = row[:-1]
    target = row[-1]

    # Positive example
    if target == 'Yes':

        # Generalize S
        for i in range(n):

            if S[i] == '0':
                S[i] = attributes[i]

            elif S[i] != attributes[i]:
                S[i] = '?'

    # Negative example
    else:

        new_G = []

        for g in G:

            for i in range(n):

                if g[i] == '?':
                    new_g = g.copy()

                    # Specialize using S
                    if S[i] != '0' and S[i] != '?':
                        new_g[i] = S[i]
                        new_G.append(new_g)

        G = new_G


# Display result
print("Specific Boundary (S):")
print(S)

print("\nGeneral Boundary (G):")
for g in G:
    print(g)
