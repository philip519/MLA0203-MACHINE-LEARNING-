# Candidate Elimination Algorithm

data = [
    ['Sunny', 'Warm', 'Normal', 'Strong', 'Warm', 'Same', 'Yes'],
    ['Sunny', 'Warm', 'High', 'Strong', 'Warm', 'Same', 'Yes'],
    ['Rainy', 'Cold', 'High', 'Strong', 'Warm', 'Change', 'No'],
    ['Sunny', 'Warm', 'High', 'Strong', 'Cool', 'Change', 'Yes']
]
n = len(data[0]) - 1
S = ['0'] * n
G = [['?'] * n]
for row in data:
    attributes = row[:-1]
    target = row[-1]
    if target == 'Yes':
        for i in range(n):
            if S[i] == '0':
                S[i] = attributes[i]
            elif S[i] != attributes[i]:
                S[i] = '?'
    else:
        new_G = []
        for g in G:
            for i in range(n):
                if g[i] == '?':
                    new_g = g.copy()
                    if S[i] != '0' and S[i] != '?':
                        new_g[i] = S[i]
                        new_G.append(new_g)
        G = new_G
print("Specific Boundary (S):")
print(S)
print("\nGeneral Boundary (G):")
for g in G:
    print(g)
